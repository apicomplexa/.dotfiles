partial alphanumeric_keys
xkb_symbols "common" {
    //                       обычн.    Shift     Caps         Caps+Shift
    key <TLDE> { [ NoSymbol, NoSymbol, grave,       asciitilde   ] };
    key <AE01> { [ NoSymbol, NoSymbol, exclam,      asciitilde   ] };
    key <AE02> { [ NoSymbol, NoSymbol, at,          at           ] };
    key <AE03> { [ NoSymbol, NoSymbol, numbersign,  numerosign   ] };
    key <AE04> { [ NoSymbol, NoSymbol, dollar,      dollar       ] };
    key <AE05> { [ NoSymbol, NoSymbol, percent,     percent      ] };
    key <AE06> { [ NoSymbol, NoSymbol, asciicircum, asciicircum  ] };
    key <AE07> { [ NoSymbol, NoSymbol, ampersand,   ampersand    ] };
    key <AE08> { [ NoSymbol, NoSymbol, asterisk,    asterisk     ] };
    key <AD11> { [ NoSymbol, NoSymbol, bracketleft, braceleft    ] };
    key <AD12> { [ NoSymbol, NoSymbol, bracketright,braceright   ] };
    key <BKSL> { [ NoSymbol, NoSymbol, bar,         slash        ] };
    key <AC10> { [ NoSymbol, NoSymbol, semicolon,   colon        ] };
    key <AC11> { [ NoSymbol, NoSymbol, apostrophe,  quotedbl     ] };
    key <AB08> { [ NoSymbol, NoSymbol, less,        less         ] };
    key <AB09> { [ NoSymbol, NoSymbol, greater,     greater      ] };
    key <AB10> { [ NoSymbol, NoSymbol, question,    question     ] };
};

partial alphanumeric_keys
xkb_symbols "us" {
    include "us(basic)"
    include "capsym(common)"
    name[Group1] = "English (US, capsym)";
};

partial alphanumeric_keys
xkb_symbols "ru" {
    include "ru"
    include "capsym(common)"
    name[Group1] = "Russian (capsym)";
};