layout {

    focus-ring {
        active-color   "#7575d7"
        inactive-color "#000000"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#7575d7"
        inactive-color "#000000"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#7575d7"
        inactive-color "#1f1f7b"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#7575d780"
    }
}

recent-windows {
    highlight {
        active-color "#7575d7"
        urgent-color "#fd4663"
    }
}
